{
  "name": "lockwire",
  "version": "0.1.0",
  "description": "Bind documentation claims to code fingerprints. Catch stale CLAUDE.md, AGENTS.md and docs at write time inside Claude Code and Codex, with a tamper-evident history.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "lockwire": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "grammars",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run grammars && tsc -p tsconfig.build.json",
    "grammars": "node scripts/grammars.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "test": "vitest run",
    "prepack": "npm run build"
  },
  "keywords": [
    "documentation",
    "docs-as-code",
    "documentation-drift",
    "stale-docs",
    "claude-code",
    "claude-code-plugin",
    "codex",
    "mcp",
    "mcp-server",
    "tree-sitter",
    "ai-agents",
    "context-engineering",
    "agents-md",
    "claude-md",
    "developer-tools"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Reality-Ventures/lockwire.git"
  },
  "homepage": "https://github.com/Reality-Ventures/lockwire#readme",
  "bugs": {
    "url": "https://github.com/Reality-Ventures/lockwire/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.1",
    "@noble/hashes": "2.4.0",
    "web-tree-sitter": "0.27.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "22.19.7",
    "tree-sitter-javascript": "0.25.0",
    "tree-sitter-python": "0.25.0",
    "tree-sitter-typescript": "0.23.2",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
